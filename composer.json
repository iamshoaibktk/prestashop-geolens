  "require": { "php": ">=8.1" },
  "require-dev": { "phpunit/phpunit": "^10.5" },
  "autoload": {
    "psr-4": { "Iamshoaibktk\\Geolens\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Iamshoaibktk\\Geolens\\Tests\\": "tests/" }
  },
  "config": { "prepend-autoloader": false, "optimize-autoloader": true },
